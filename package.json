{
  "name": "cove-browser",
  "version": "0.6.0",
  "private": true,
  "description": "An open-source, calmer home for the internet.",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "desktop": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env COVE_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:site": "playwright test --config playwright.site.config.js",
    "test:desktop": "npm run build && node scripts/smoke-desktop.mjs && node scripts/smoke-private.mjs && node scripts/smoke-resources.mjs",
    "package": "npm run build && node scripts/package-desktop.mjs",
    "release:archive": "node scripts/archive-release.mjs",
    "verify": "npm test && npm run test:e2e && npm run test:desktop"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.58.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "vite": "^8.3.5",
    "wait-on": "^9.0.0"
  },
  "type": "module"
}
